"><button class=\"btn btn-outline-danger mt-3 mb-3\" type=\"button\" style"
"=\"text-align: center;\">Get the SDK</button></a> <a href=\"docs.html\" style"
"=\"text-align:center\"><button class=\"btn btn-outline-danger mt-3 mb-3\" "
"type=\"button\" style=\"text-align: center;\">Integration Guide</button></a>"
msgstr ""
"<a href=\"https://gitlab.com/equalitie/ouinet\" style=\"text-align:center\""
"><button class=\"btn btn-outline-danger mt-3 mb-3\" type=\"button\" style"
"=\"text-align: center;\"> SDK ஐப் பெறுங்கள்</button></a><a href=\"docs.html\" "
"style=\"text-align:center\"> <button class="
"\"btn btn-outline-danger mt-3 mb-3\" type=\"button\" style=\"text-align: "
